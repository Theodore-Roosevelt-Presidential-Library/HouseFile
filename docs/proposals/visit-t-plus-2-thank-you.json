  "title": "VISIT: T+2 Thank You",
  "subject": "Thank you for coming to the Badlands",
  "preheader": "Pick what you want to hear about next, from the archive to the prairie.",
  "fromName": "Theodore Roosevelt Presidential Library",
  "blocks": [
    {
      "type": "header",
      "props": {
        "src": "proposals/img/visit-t-plus-2-thank-you-header.jpg",
        "alt": "Theodore Roosevelt Presidential Library",
        "href": "https://www.trlibrary.com"
      }
    },
    {
      "type": "heading",
      "props": {
        "text": "Thank You for Coming",
        "align": "center"
      }
    },
    {
      "type": "text",
      "props": {
        "html": "Hello [[FIRSTNAME OR \"Friend\"]],<br><br>Thank you for spending a day at the Theodore Roosevelt Presidential Library. If you carried a Trailblazer through the galleries, your journal and photos arrived in a separate email. They stay online for 30 days, so save the ones you want to keep.",
        "align": "left"
      }
    },
    {
      "type": "text",
      "props": {
        "html": "<b>Thank you for being a member.</b> Your membership does more than open the doors for you. It supports educational programming, conservation education and the work of keeping T.R.'s story alive for every visitor who comes after you.",
        "align": "left"
      },
      "cond": {
        "group": "p1",
        "tag": "custom.acme_-_is_active_member",
        "field": "Acme - Is Active Member",
        "label": "Membership",
        "other": "Not a member",
        "kind": "if",
        "is": [
          "active",
          "new"
        ]
      }
    },
    {
      "type": "divider",
      "props": {}
    },
    {
      "type": "heading",
      "props": {
        "text": "How Was Your Visit?",
        "align": "center"
      }
    },
    {
      "type": "text",
      "props": {
        "html": "A few words from you help the next traveler decide to make the trip to Medora. The Library reads every review, and a short one counts just as much as a long one.",
        "align": "left"
      }
    },
    {
      "type": "button",
      "props": {
        "label": "Review on Google",
        "href": "https://search.google.com/local/writereview?placeid=ChIJbynQegDrJVMRSCAxmOeViVg"
      }
    },
    {
      "type": "text",
      "props": {
        "html": "Or share it on <a href=\"https://www.tripadvisor.com/UserReviewEdit-g60973-d34391224-Theodore_Roosevelt_Presidential_Library-Medora_North_Dakota.html\">TripAdvisor</a> or <a href=\"https://www.yelp.com/writeareview/biz/pj4rzLmUB3s-Vxc4JAfhwg\">Yelp</a>.",
        "align": "center"
      }
    },
    {
      "type": "divider",
      "props": {}
    },
    {
      "type": "heading",
      "props": {
        "text": "Stay Connected to What Interests You",
        "align": "center"
      }
    },
    {
      "type": "text",
      "props": {
        "html": "Stay connected to the Theodore Roosevelt Presidential Library through <i>Mail from the Badlands</i>. Choose the topics that interest you most and receive updates tailored to your preferences.",
        "align": "left"
      }
    },
    {
      "type": "table",
      "props": {
        "intro": "",
        "note": "",
        "columns": [
          "Topic",
          "What arrives"
        ],
        "rows": [
          [
            "From the Archive",
            "One story a month from the collection: a page of T.R.'s diary, a letter home from the Badlands, an object with a history."
          ],
          [
            "The Badlands",
            "A monthly look at the landscape that shaped T.R., and at the native prairie being restored across the Library's 93 acres."
          ],
          [
            "Events & Programs",
            "Talks, family days, festivals and evening programs, sent while seats are still open."
          ],
          [
            "Library News & History",
            "Exhibition openings, building news and stories from the collection. The one to pick if you pick only one."
          ],
          [
            "Conservation & Sustainability",
            "How the building works and what the land is doing, plus the Native Plant Project."
          ],
          [
            "Salt+Scoria",
            "Seasonal menus, special dinners and reservation windows at the Library's restaurant."
          ],
          [
            "The Shop",
            "New arrivals, seasonal sales and small-batch goods from the Library Shop."
          ],
          [
            "Educators & Homeschool",
            "Primary sources, field trip booking windows and professional development, five or six emails a year."
          ]
