# Constant Contact API credentials
# Copy this file to ".env" and fill in your real values.
# The .env file is gitignored and must NEVER be committed.

# From your Constant Contact developer app
CC_CLIENT_ID=
CC_CLIENT_SECRET=

# Redirect URI you set on the app (used only for the one-time authorization)
CC_REDIRECT_URI=http://localhost:8080/callback

# Populated by the one-time authorize helper, then copied into GitHub Secrets.
CC_REFRESH_TOKEN=
